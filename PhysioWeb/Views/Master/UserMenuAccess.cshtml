@model PhysioWeb.Models.UserAccess
@{
	ViewBag.Title = "Menu Access";
	var theme = User.FindFirst("Theme")?.Value ?? "#198754";
}
<style>
	:root {
		--theme-color: @theme;
		--sidebar-width: 280px;
		--sidebar-collapsed-width: 70px;
		--transition-speed: 0.3s;
		--primary-color: @theme;
		--secondary-color: #6c757d;
		--light-bg: #f8f9fa;
	}
</style>

<main class="dashboard-content with-sidebar collapsed">
	<div class="container-fluid mt-4">
		<h4 class="my-3">Menu Access</h4>
		<div class="row">
			<div class="col-md-5 my-3">
				<label class="form-label fw-bold">Select User Role</label>
				<select class="form-select" name="UserRole" id="UserRole">
					<option value="">Select User Role</option>
					@foreach (var item in Model.UserRoles)
					{
						<option value="@item.Value">@item.Text</option>
					}
				</select>
			</div>
		</div>

		<table class="table table-bordered table-hover align-middle" id="MenuAccessTbl">
			<thead class="table-light">
				<tr>
					<th style="width: 80px;">Action</th>
					<th style="width: 250px;">Menu Name</th>
					<th>Sub Menu Name</th>
				</tr>
			</thead>

			<tbody>

				@foreach (var parent in Model.SideBarMenu)
				{
					if (parent.RowNo == 0)
					{

						<tr class="table-secondary fw-semibold">
							<td>
								<input type="checkbox"
									   class="form-check-input parent_@parent.ParentMenuId MyParentCheckBox"
									   value="@parent.UniquId"
									   id="Menu_@parent.UniquId"
								@(parent.IsChecked ? "checked" : "") />
							</td>
							<td colspan="2">
								@parent.MenuName
							</td>
						</tr>
					}

					else
					{
						<tr>
							<td></td>
							<td>
								<input type="checkbox"
									   class="form-check-input child_@parent.ParentMenuId MyChildCheckBox"
									   data-parent="@parent.ParentMenuId"
									   value="@parent.UniquId"
									   id="Menu_@parent.UniquId"
								@(parent.IsChecked ? "checked" : "") />
							</td>
							<td class="ps-4">
								@parent.MenuName
							</td>
						</tr>
					}

				}

			</tbody>
		</table>
		<div class="row">
			<div class="d-flex justify-content-center">
				<buttton class="btn btn-primary" type="button" onclick="SaveMenuAccess()">Save/Update</buttton>
			</div>
		</div>
	</div>
</main>
@section Scripts {

	<script>
		$(".MyParentCheckBox").on("click", function () {
			var parentId = $(this).val();

			var isChecked = $(this).is(':checked');

			$(".child_" + parentId).prop("checked", isChecked);
		});


		$(document).on("change", ".MyChildCheckBox", function () {

			var parentId = $(this).data("parent");

			// check if ANY child is selected
			var anyChecked = $(".child_" + parentId + ":checked").length > 0;

			$(".parent_" + parentId).prop("checked", anyChecked);
		});

		function SaveMenuAccess(){
				var checkedParents = $("#MenuAccessTbl tbody tr .MyParentCheckBox:checked").length;

				if(checkedParents<0){
					notyf.error("Please Select Atleadt One Menu");
				}
				else{

					var selectedParents = $("#MenuAccessTbl tbody tr .MyParentCheckBox:checked").map(function () {
						return $(this).val();
						}).get().join(",");


					var selectChilds = $("#MenuAccessTbl tbody tr .MyChildCheckBox:checked").map(function () {
						return $(this).val();
						}).get().join(",");

					var roleId = $("#UserRole").val();
					// ajax call here

					if(selectedParents != "" && selectChilds!=""){
						 $.ajax({
							url: '/Master/SaveRoleMenus',
							type: 'POST',
							contentType: 'application/json',
							data: JSON.stringify({
								roleId: roleId,
								menuIds: selectedParents+","+selectChilds
							}),
							success: function (response) {
								notyf.success("Saved successfully");
							},
							error: function (err) {
								console.error(err);
								notyf.error("Error while saving");
							}
						});
					}


				}

		}

		$("#UserRole").on("change",function(){
			var RoleId = $(this).val();
			$(".MyParentCheckBox").prop("checked",false);
			$(".MyChildCheckBox").prop("checked",false);
			if(RoleId){
					$.ajax({
					url: '/Master/GetMenusByRole',
					type: 'GET',
					data: { roleId: RoleId },
					success: function (response) {
						console.log(response);
								for (let menuId of response) {
									$("#Menu_"+menuId).prop("checked",true);
							}
					},
					error: function (err) {
						console.error(err);
					}
				});
			}

		})
	</script>

}