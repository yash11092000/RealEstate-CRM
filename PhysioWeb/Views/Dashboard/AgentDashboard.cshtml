@{
    ViewBag.Title = "Agent Dashboard";
    var theme = User.FindFirst("Theme")?.Value ?? "#198754";
}

<style>
    .navbar-agent {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        box-shadow: 0 4px 12px rgba(67, 97, 238, 0.15);
    }

    .agent-header {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-top: 20px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .agent-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border: none;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 15px;
    }

    .lead-item {
        padding: 15px;
        border-radius: 10px;
        background: white;
        margin-bottom: 10px;
        border-left: 4px solid var(--primary-color);
        transition: all 0.3s;
    }

        .lead-item:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

    .lead-hot {
        border-left-color: var(--warning-color);
    }

    .lead-warm {
        border-left-color: #ff9e00;
    }

    .appointment-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        border-left: 4px solid var(--success-color);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }

    .appointment-urgent {
        border-left-color: var(--warning-color);
    }


    .progress-agent {
        height: 8px;
        border-radius: 10px;
    }

    .performance-chart {
        background: white;
        border-radius: 12px;
        padding: 20px;
        height: 100vh;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .quick-action-btn {
        background: white;
        border: none;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        transition: all 0.3s;
        width: 100%;
    }

        .quick-action-btn:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-5px);
        }

    .badge-agent {
        padding: 5px 10px;
        border-radius: 20px;
        font-weight: 500;
    }

    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background-color: var(--warning-color);
        color: white;
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .agent-nav-tabs .nav-link {
        border: none;
        color: #6c757d;
        font-weight: 500;
        padding: 10px 20px;
        border-radius: 8px;
    }

        .agent-nav-tabs .nav-link.active {
            background-color: var(--primary-color);
            color: white;
        }

    @@media (max-width: 768px) {
        .agent-header {
            text-align: center;
        }

        .agent-avatar {
            margin: 0 auto 15px;
        }
    }

</style>


<main class="dashboard-content with-sidebar collapsed">

<div class="container-fluid py-4">
    <!-- Agent Header -->
    <div class="agent-header">
        <div class="row align-items-center">
            <div class="col-md-9">
                <div class="d-flex align-items-center">
                    <img src="https://images.unsplash.com/photo-1494790108755-2616c113a1c2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=200&q=80"
                         class="agent-avatar me-4" alt="Agent">
                    <div>
                        <h1 class="h3 mb-1">Welcome back, Sarah!</h1>
                        <p class="text-muted mb-2">Senior Real Estate Agent | 5.0 ★ Rating</p>
                        <div class="d-flex flex-wrap">
                            <span class="badge bg-primary badge-agent me-2 mb-1">
                                <i class="bi bi-trophy me-1"></i> Top Performer
                            </span>
                            <span class="badge bg-success badge-agent me-2 mb-1">
                                <i class="bi bi-check-circle me-1"></i> 12 Deals This Month
                            </span>
                            <span class="badge bg-info badge-agent mb-1">
                                <i class="bi bi-star me-1"></i> 98% Client Satisfaction
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 text-md-end mt-3 mt-md-0">
                <button class="btn btn-primary me-2">
                    <i class="bi bi-plus-circle me-1"></i> Add Property
                </button>
                <button class="btn btn-outline-primary">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mt-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-house-door"></i>
                </div>
                <h3 class="fw-bold">24</h3>
                <p class="text-muted mb-2">Active Listings</p>
                <div class="progress progress-agent">
                    <div class="progress-bar bg-primary" style="width: 85%"></div>
                </div>
                <small class="text-success"><i class="bi bi-arrow-up"></i> 3 new this week</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="fw-bold">18</h3>
                <p class="text-muted mb-2">Hot Leads</p>
                <div class="progress progress-agent">
                    <div class="progress-bar bg-success" style="width: 65%"></div>
                </div>
                <small class="text-success"><i class="bi bi-arrow-up"></i> 5 new today</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <h3 class="fw-bold">7</h3>
                <p class="text-muted mb-2">Today's Appointments</p>
                <div class="progress progress-agent">
                    <div class="progress-bar bg-warning" style="width: 45%"></div>
                </div>
                <small class="text-danger"><i class="bi bi-clock me-1"></i> 2 starting soon</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <h3 class="fw-bold">$287K</h3>
                <p class="text-muted mb-2">Monthly Commission</p>
                <div class="progress progress-agent">
                    <div class="progress-bar bg-danger" style="width: 72%"></div>
                </div>
                <small class="text-success"><i class="bi bi-arrow-up"></i> 12% above target</small>
            </div>
        </div>
    </div>

    <!-- Main Dashboard Content -->
    <div class="row">
        <!-- Left Column: Leads & Appointments -->
        <div class="col-lg-8">
            <!-- Leads Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-people me-2"></i>Recent Leads
                        </h5>
                        <a href="#" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>

                    <!-- Lead Tabs -->
                    <ul class="nav nav-tabs agent-nav-tabs mb-3" id="leadTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#hot-leads">Hot (8)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#warm-leads">Warm (12)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#cold-leads">Cold (5)</button>
                        </li>
                    </ul>

                    <!-- Lead Content -->
                    <div class="tab-content" id="leadTabsContent">
                        <div class="tab-pane fade show active" id="hot-leads">
                            <div class="lead-item lead-hot">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">Michael Rodriguez</h6>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-house me-1"></i>Looking for 3BHK villa, budget $750K
                                        </p>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>Contacted: Today, 10:30 AM</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-warning">Priority</span>
                                        <p class="mt-2 mb-0">
                                            <button class="btn btn-sm btn-outline-primary">Follow Up</button>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="lead-item lead-hot">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">Jennifer Lee</h6>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-building me-1"></i>Commercial space, 2000-3000 sq ft
                                        </p>
                                        <small class="text-muted"><i class="bi bi-calendar me-1"></i>Viewing scheduled: Tomorrow</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-danger">Urgent</span>
                                        <p class="mt-2 mb-0">
                                            <button class="btn btn-sm btn-primary">Call Now</button>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="lead-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">Robert Chen</h6>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-house me-1"></i>First-time buyer, budget $350K
                                        </p>
                                        <small class="text-muted"><i class="bi bi-envelope me-1"></i>Email sent: Yesterday</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-success">Ready to buy</span>
                                        <p class="mt-2 mb-0">
                                            <button class="btn btn-sm btn-outline-success">Send Quote</button>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Other tabs would have similar content -->
                    </div>
                </div>
            </div>

            <!-- Today's Appointments -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-calendar-check me-2"></i>Today's Schedule
                        </h5>
                        <a href="#" class="btn btn-sm btn-outline-primary">Full Calendar</a>
                    </div>

                    <div class="appointment-card appointment-urgent">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">Property Showing: Luxury Villa</h6>
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>123 Beverly Hills, LA
                                </p>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>10:30 AM - 11:30 AM |
                                    <i class="bi bi-people me-1 ms-2"></i>Jennifer Lee & Family
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-danger">Starting in 45 min</span>
                                <p class="mt-2 mb-0">
                                    <button class="btn btn-sm btn-danger">Join Call</button>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="appointment-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">Contract Signing</h6>
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-file-text me-1"></i>Apartment #304 Lease Agreement
                                </p>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>2:00 PM - 3:00 PM |
                                    <i class="bi bi-person me-1 ms-2"></i>David Wilson
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary">At Office</span>
                                <p class="mt-2 mb-0">
                                    <button class="btn btn-sm btn-outline-primary">View Docs</button>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="appointment-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">Client Consultation</h6>
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-chat-dots me-1"></i>Investment Property Advice
                                </p>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>4:30 PM - 5:30 PM |
                                    <i class="bi bi-people me-1 ms-2"></i>Robert & Maria Garcia
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success">Virtual Meeting</span>
                                <p class="mt-2 mb-0">
                                    <button class="btn btn-sm btn-success">Prepare Materials</button>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Quick Actions & Performance -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-lightning me-2"></i>Quick Actions
                    </h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <button class="quick-action-btn">
                                <i class="bi bi-plus-circle-fill h4 text-primary mb-2"></i>
                                <p class="mb-0 small">Add Lead</p>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="quick-action-btn">
                                <i class="bi bi-calendar-plus-fill h4 text-success mb-2"></i>
                                <p class="mb-0 small">Schedule Tour</p>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="quick-action-btn">
                                <i class="bi bi-file-earmark-plus-fill h4 text-warning mb-2"></i>
                                <p class="mb-0 small">Create Contract</p>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="quick-action-btn">
                                <i class="bi bi-camera-fill h4 text-info mb-2"></i>
                                <p class="mb-0 small">Add Photos</p>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Performance Chart -->
            <div class="performance-chart">
                <h5 class="card-title mb-3">
                    <i class="bi bi-graph-up me-2"></i>Monthly Performance
                </h5>
                <div class="text-center mb-3" style="height: 200px; background-color: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <div>
                        <i class="bi bi-bar-chart h1 text-muted"></i>
                        <p class="text-muted mt-2">Deals Closed vs Target</p>
                    </div>
                </div>
                <div class="row text-center">
                    <div class="col-6">
                        <h3 class="text-primary">12</h3>
                        <p class="text-muted small">Deals Closed</p>
                    </div>
                    <div class="col-6">
                        <h3 class="text-success">$287K</h3>
                        <p class="text-muted small">Commission</p>
                    </div>
                </div>
                <div class="mt-3">
                    <p class="mb-1">Monthly Target Progress</p>
                    <div class="progress progress-agent">
                        <div class="progress-bar bg-primary" style="width: 85%"></div>
                    </div>
                    <small class="text-success">15% ahead of schedule</small>
                </div>
            </div>
        </div>
    </div>
</div>
</main>
