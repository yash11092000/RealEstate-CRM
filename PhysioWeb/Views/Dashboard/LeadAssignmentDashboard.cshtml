@model PhysioWeb.Models.NewLead

@{
    ViewData["Title"] = "Lead Assignment Dashboard";
    var theme = User.FindFirst("Theme")?.Value ?? "#198754";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer" />
<style>

    :root {
        --theme-color: @theme;
        --sidebar-width: 280px;
        --sidebar-collapsed-width: 70px;
        --transition-speed: 0.3s;
        --primary-color: @theme;
        --secondary-color: #6c757d;
        --light-bg: #f8f9fa;
    }

    .custom-tabs .nav-link {
        border-radius: 30px;
        padding: 8px 18px;
        font-weight: 500;
        color: var(--primary-color);
        background: #f1f3f5;
        margin-right: 10px;
        transition: 0.2s ease-in-out;
    }

        .custom-tabs .nav-link.active {
            background-color: var(--primary-color);
            color: #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .custom-tabs .nav-link:hover {
            background-color: var(--primary-color);
            color: #fff;
        }

    .table thead th {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-assign {
        background-color: var(--primary-color);
        border: none;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 13px;
    }

        .btn-assign:hover {
            opacity: 0.9;
        }
</style>
<main class="dashboard-content with-sidebar collapsed">
    <div class="container-fluid mt-4">

        <!-- Card Wrapper -->
        <div class="card shadow-sm border-0">
           @*  <div class="card-header text-white d-flex justify-content-between align-items-center"
                 style="background-color: var(--primary-color);">
                <h5 class="mb-0">
                    <i class="bi bi-diagram-3-fill me-2"></i>
                    Assignment Dashboard
                </h5>
            </div> *@

            <div class="card-body">

                <!-- Modern Tabs -->
                <ul class="nav nav-pills mb-4 custom-tabs" id="leadTabs">
                    <li class="nav-item">
                        <button class="nav-link active" data-tab="Assigned">
                            <i class="bi bi-person-check-fill me-1"></i>
                            Assigned
                            @* <span class="badge bg-light text-dark ms-1" id="assignedCount">0</span> *@
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-tab="Unassigned">
                            <i class="bi bi-person-x-fill me-1"></i>
                            Unassigned
                            @* <span class="badge bg-light text-dark ms-1" id="unassignedCount">0</span> *@
                        </button>
                    </li>
                </ul>
              @*   <!-- Classic Tabs -->
                <ul class="nav nav-tabs mb-4" id="leadTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active"
                                id="assigned-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#Assigned"
                                type="button"
                                role="tab">
                            <i class="bi bi-person-check-fill me-1"></i>
                            Assigned
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                id="unassigned-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#Unassigned"
                                type="button"
                                role="tab">
                            <i class="bi bi-person-x-fill me-1"></i>
                            Unassigned
                        </button>
                    </li>
                </ul> *@
                <div class="col-md-12 d-flex justify-content-end align-items-end gap-3">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Users List</label>
                        <select class="form-select" name="UserIdForAssign" id="UserIdForAssign">
                            <option value="">Select Users</option>
                            @foreach (var item in Model.UsersListForAssign)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <button type="button" class="btn btn-success" id="btnAssigned">
                            <i class="fa-solid fa-users"></i> Assign Leads To User
                        </button>
                    </div>

                </div>
                <!-- Table -->
                <div class="table-responsive">
                    <table id="TableList" class="table table-hover align-middle table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">
                                    <input type="checkbox" id="selectAll" />
                                </th>
                                <th style="width:50px;">Sr No</th>
                                <th>Lead</th>
                                <th>Contact</th>
                                <th>Property Type</th>
                                <th>Budget</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Assigned Agent</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>
</main>

@section Scripts {

    <script>
        $(document).ready(function() {


            let currentTab = "Assigned"; // default

            // Clone header for filters (your existing code)
            $('#TableList thead tr').clone(true).appendTo('#TableList thead');
            $('#TableList thead tr:eq(1) th').each(function(i) {
                if ($(this).find('i').length === 0) {
                    var title = $('#TableList thead tr:eq(0) th').eq(i).text().trim();
                    $(this).html('<input class="form-control form-control-sm" type="text" placeholder="' + title + '" />');
                } else {
                    $(this).html('');
                }
            });

            var table = $("#TableList").DataTable({
                orderCellsTop: true,
                processing: true,
                serverSide: true,
                order: [[0, "asc"]],
                ajax: {
                    url: '/Dashboard/LeadList',
                    type: 'POST',
                    data: function(d) {
                        // ← This is the key part
                        d.tab = currentTab;           // send "Assigned" or "Unassigned"
                        // You can add more filters later, e.g. d.searchType = "myLeadsOnly";
                        return d;
                    },
                    dataSrc: function(json) {
                        console.log("Server response:", json);
                        // Optional: update counts if your backend sends them
                        if (json.recordsTotal !== undefined) {
                            // or if you send custom properties:
                            // $('#assignedCount').text(json.assignedCount || 0);
                            // $('#unassignedCount').text(json.unassignedCount || 0);
                        }
                        return json.data || [];
                    }
                },
                columns: [
                    {
                        data: null,
                        render: function(data, type, row) {
                            return `<input type="checkbox" class="row-checkbox" value="${row.leadId ?? ''}" />`;
                        },
                        orderable: false,
                        searchable: false
                    },
                    {
                        data: null,
                        render: function(data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        },
                        orderable: false,
                        searchable: false
                    },
                    { data: 'leadName' },
                    { data: 'contactPerMobNo' },
                    { data: 'propertyName' },
                    { data: 'budget' },
                    { data: 'status' },
                    { data: 'priority' },
                    { data: 'assignAgent' },
                    {
                        data: null,
                        render: function(data, type, row) {
                            return `<i class="fa-solid fa-circle-plus" style="font-size: larger;"></i></i>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                initComplete: function() {
                    // your column search binding
                    $('#TableList thead tr:eq(1) th').each(function(i) {
                        $('input', this).on('keyup change', function() {
                            if (table.column(i).search() !== this.value) {
                                table.column(i).search(this.value).draw();
                            }
                        });
                    });
                }
            });

            // Tab switching
            $('#leadTabs button').on('click', function() {
                $('#leadTabs button').removeClass('active');
                $(this).addClass('active');

                currentTab = $(this).data('tab');   // "Assigned" or "Unassigned"

                table.ajax.reload(null, false);     // reload + keep current paging/search
            });
        });

      
        $('#btnAssigned').on('click', function() {
            //ajax call 
        });
        
        $('#selectAll').on('change', function() {
            $('.row-checkbox').prop('checked', this.checked);
        });

      
        $(document).on('change', '.row-checkbox', function() {
            if (!this.checked) {
                $('#selectAll').prop('checked', false);
            }
        });

        function getSelectedLeads() {
            let ids = [];
            $('.row-checkbox:checked').each(function() {
                ids.push($(this).val());
            });
            return ids;
        }
    </script>
}